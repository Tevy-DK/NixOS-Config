// ═══════════════════════════════════════════════════════
// Niri 配置 — noctalia 外壳 + 玻璃效果
// bar/启动器/控制中心/通知/OSD/托盘/剪贴板/锁屏/会话/壁纸/polkit 全在 noctalia
// （用户配置 home/noctalia.nix，包与服务 system/niri.nix），niri 只管布局与键位。
// 玻璃：noctalia 面板层 xray=false 走合成器模糊 + 全局 blur 调参；概览壁纸进 backdrop。
// 圆角 8px + 1px 常亮边框。配色取自 system/theme.nix（NixOS logo 紫蓝系）；
// kdl 是静态文件，色值需手动同步：
//   bg #2E3246（overview backdrop 兜底色） · accent #649AFA · border #4A506B · urgent #D9827B
// ═══════════════════════════════════════════════════════

// 输入法守护进程（waylandFrontend 模式需要会话内自启，同 koru）
spawn-at-startup "fcitx5" "-d"

// 壁纸由 noctalia 渲染（systemd 用户服务拉起，壁纸层进 backdrop，见 layer-rule），
// 不再需要 awww 的 spawn-at-startup。

// ─── 环境变量导入 ─────────────────────────────────────
spawn-sh-at-startup "dbus-update-activation-environment --all --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_ID"
spawn-sh-at-startup "systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP"

// ─── 基础设置 ─────────────────────────────────────────
config-notification {
    disable-failed
}

gestures {
    hot-corners {
        off
    }
}

// ─── 输入设备 ─────────────────────────────────────────
input {
    keyboard {
        xkb {
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
        accel-speed 0.0
        dwt
    }

    mouse {
        accel-speed 0.0
    }
}

// ─── 输出 ─────────────────────────────────────────────
output "HDMI-A-1" {
    mode "1920x1080@100.003"
    scale 1
    position x=0 y=0
}

// ─── 布局（1px 常亮圆角边框 + 窗口阴影；顶部空间交给 noctalia bar）──
layout {
    // 工作区背景全透明：壁纸由 noctalia 渲染并经 place-within-backdrop 放在
    // backdrop 里（见下方 layer-rule），常规桌面靠这里透出来。
    // 壁纸守护不在时，由 overview 的 backdrop-color（#2E3246）兜底。
    background-color "transparent"
    gaps 8

    preset-column-widths {
        proportion 0.5
        proportion 0.25
        proportion 0.75
    }

    default-column-width {
        proportion 0.5
    }

    // koru 的做法：focus-ring 关（不关会漏出 niri 默认的蓝色聚焦环）、border 常亮
    focus-ring {
        off
    }

    border {
        on
        width 1
        active-color   "#649AFA"
        inactive-color "#4A506B"
        urgent-color   "#D9827B"
    }

    // 窗口阴影（noctalia 面板的影子由它自己的 [shell.shadow] 画，这里管应用窗口；
    // layout.shadow 必须写 on 才生效）
    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    tab-indicator {
        corner-radius  8
        active-color   "#649AFA"
        inactive-color "#4A506B"
        urgent-color   "#D9827B"
    }

    insert-hint {
        color "#649AFA80"
    }
}

// ─── 光标（与 home/cursor-theme.nix 的重着色主题同名）──
cursor {
    xcursor-theme "Bibata-Modern-DK"
    xcursor-size 24
}

overview {
    backdrop-color "#2E3246"
    workspace-shadow {
        off
    }
}

// ─── 壁纸进 overview backdrop（DMS 同构： stationary 壁纸 + 无卡片重渲染）──
// DMS 的做法是壁纸层（namespace=quickshell）整体 place-within-backdrop：壁纸
// 常驻不动、不随工作区滚动，且 backdrop 里的层不会被 niri 逐工作区重渲染进
// 概览卡片——概览里壁纸是一整块连续的，窗口直接浮在上面。noctalia 壁纸层
// （noctalia-wallpaper）同样放进来，得到同款构图。
// 与 DMS 的唯一差距：DMS 会在概览打开时把壁纸层原地自模糊（监听 niri 事件），
// noctalia 的壁纸层没有这个钩子，静态模糊副本层（noctalia-backdrop）又只能
// 常开（放上去桌面跟着糊），所以 [backdrop] 在 noctalia.nix 里关着——概览壁
// 纸是清晰的。想要「模糊背景 + 清晰小卡片」的 Option 1 风格：打开 [backdrop]
// 并删掉下面 noctalia-wallpaper 这条规则即可。
layer-rule {
    match namespace=r#"^noctalia-backdrop"#
    place-within-backdrop true
}

layer-rule {
    match namespace=r#"^noctalia-wallpaper"#
    place-within-backdrop true
}

environment {
    XDG_CURRENT_DESKTOP "niri"
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// ─── 动画 ─────────────────────────────────────────────
animations {
    workspace-switch {
        spring damping-ratio=0.80 stiffness=523 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
    horizontal-view-movement {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.75 stiffness=323 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.85 stiffness=423 epsilon=0.0001
    }
    config-notification-open-close {
        spring damping-ratio=0.65 stiffness=923 epsilon=0.001
    }
    screenshot-ui-open {
        duration-ms 200
        curve "ease-out-quad"
    }
    overview-open-close {
        spring damping-ratio=0.85 stiffness=800 epsilon=0.0001
    }
}

// ─── 玻璃/模糊（niri ≥26.04，noctalia 官方推荐写法）──
// noctalia 的面板/OSD 自己上报 blur 区域（ext-background-effects 协议），这里只
// 纠 xray：false = 模糊采样身后的窗口内容而不是壁纸，避免圆角处漏出壁纸色点。
// 要整层关掉 noctalia 的模糊：match namespace="^noctalia-" + blur false。
layer-rule {
    match namespace=r#"^noctalia-(bar-[^"]+|notification|dock|panel|attached-panel|osd)$"#
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace=r#"noctalia-window-switcher"#
    background-effect {
        blur true
        xray false
    }
}

// 全局模糊调参（noctalia 推荐值；默认 passes 3 / noise 0.02 / saturation 1.5）
blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.0
}

// ─── 窗口规则 ─────────────────────────────────────────
window-rule {
    // 全局圆角：边框/聚焦环跟随此半径变圆，clip-to-geometry 把窗口内容也裁圆
    geometry-corner-radius 8
    clip-to-geometry true
}

window-rule {
    // 终端自带深底，别让 niri 的边框画在背景上
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    draw-border-with-background false
}

window-rule {
    // 毛玻璃：终端/编辑器/文件管理器半透明 + 背景模糊。
    // app-id 用 (?i) 兜住 VS Code 系的 code/Code/codium/VSCodium/vscodium；
    // xray false 同上：采样身后内容而非壁纸
    match app-id=r#"^com\.mitchellh\.ghostty$"#
    match app-id=r#"^(?i)(code|codium|vscodium)$"#
    match app-id=r#"^org\.gnome\.Nautilus$"#
    background-effect {
        blur true
        xray false
        noise 0.01
        saturation 1.5
    }
    opacity 0.75
}

window-rule {
    // noctalia 设置窗口：浮窗，尺寸按官方 niri 接入页的推荐值。
    // 设置窗口是普通 toplevel，noctalia 只给 layer-shell 面板自动上报模糊区域，
    // 窗口侧的模糊要在这里显式开（官方文档 Blur 节的写法）。
    match app-id=r#"^dev\.noctalia\.Noctalia$"#
    open-floating true
    default-column-width {
        fixed 1080
    }
    default-window-height {
        fixed 920
    }
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    // 系统设置/音频/网络对话框：半宽平铺
    match app-id=r#"^gnome-control-center$"#
    match app-id=r#"^pavucontrol$"#
    match app-id=r#"^nm-connection-editor$"#
    default-column-width {
        proportion 0.5
    }
    open-floating false
}

window-rule {
    // 门户与文件管理器浮动
    match app-id=r#"^xdg-desktop-portal$"#
    match app-id=r#"^org\.gnome\.Nautilus$"#
    open-floating true
}

debug {
    // noctalia 的通知动作和窗口激活依赖它
    honor-xdg-activation-with-invalid-serial
}

// ─── 最近窗口 ─────────────────────────────────────────
recent-windows {
    highlight {
        // 圆角，与 border 的 radius 一致
        corner-radius 8
    }

    binds {
        Alt+Tab {
            next-window scope="output"
        }
        Alt+Shift+Tab {
            previous-window scope="output"
        }
        Alt+grave {
            next-window filter="app-id"
        }
        Alt+Shift+grave {
            previous-window filter="app-id"
        }
    }
}

// ─── 键位绑定 ─────────────────────────────────────────
// noctalia 的面板/动作统一走 `noctalia msg`（官方 niri 接入页的写法）。
binds {
    // ═══ 应用启动 ═══
    Mod+B hotkey-overlay-title="Helium Browser" {
        spawn "helium"
    }

    Mod+E hotkey-overlay-title="Yazi File Manager" {
        spawn "ghostty" "-e" "yazi"
    }

    Mod+T hotkey-overlay-title="Open Terminal" {
        spawn "ghostty"
    }

    Super+G hotkey-overlay-title="Chrome" {
        spawn "google-chrome"
    }

    Super+Shift+C hotkey-overlay-title="VSCodium" {
        spawn "codium"
    }

    // ═══ 窗口管理 ═══
    Mod+Q repeat=false {
        close-window
    }

    Mod+Shift+E {
        quit
    }

    Mod+F {
        maximize-column
    }

    Mod+Shift+F {
        fullscreen-window
    }

    Mod+W {
        toggle-column-tabbed-display
    }

    Mod+Shift+T {
        toggle-window-floating
    }

    Mod+Shift+V {
        switch-focus-between-floating-and-tiling
    }

    Mod+R {
        switch-preset-column-width
    }

    Mod+Shift+R {
        switch-preset-window-height
    }

    Mod+C {
        center-column
    }

    Mod+Ctrl+C {
        center-visible-columns
    }

    Mod+Ctrl+F {
        expand-column-to-available-width
    }

    Mod+Ctrl+R {
        reset-window-height
    }

    Mod+Equal {
        set-column-width "+10%"
    }

    Mod+Minus {
        set-column-width "-10%"
    }

    Mod+Shift+Equal {
        set-window-height "+10%"
    }

    Mod+Shift+Minus {
        set-window-height "-10%"
    }

    Mod+Period {
        expel-window-from-column
    }

    Mod+BracketLeft {
        consume-or-expel-window-left
    }

    Mod+BracketRight {
        consume-or-expel-window-right
    }

    // ═══ 焦点移动 ═══
    Mod+H {
        focus-column-left
    }

    Mod+L {
        focus-column-right
    }

    Mod+J {
        focus-window-down
    }

    Mod+K {
        focus-window-up
    }

    Mod+Left {
        focus-column-left
    }

    Mod+Right {
        focus-column-right
    }

    Mod+Up {
        focus-window-up
    }

    Mod+Down {
        focus-window-down
    }

    Mod+Home {
        focus-column-first
    }

    Mod+End {
        focus-column-last
    }

    Mod+WheelScrollLeft {
        focus-column-left
    }

    Mod+WheelScrollRight {
        focus-column-right
    }

    Mod+Shift+WheelScrollDown {
        focus-column-right
    }

    Mod+Shift+WheelScrollUp {
        focus-column-left
    }

    // ═══ 移动窗口 ═══
    Mod+Shift+H {
        move-column-left
    }

    Mod+Shift+L {
        move-column-right
    }

    Mod+Shift+J {
        move-window-down
    }

    Mod+Shift+K {
        move-window-up
    }

    Mod+Shift+Left {
        move-column-left
    }

    Mod+Shift+Right {
        move-column-right
    }

    Mod+Shift+Up {
        move-window-up
    }

    Mod+Shift+Down {
        move-window-down
    }

    Mod+Ctrl+Shift+WheelScrollDown {
        move-column-right
    }

    Mod+Ctrl+Shift+WheelScrollUp {
        move-column-left
    }

    Mod+Ctrl+WheelScrollLeft {
        move-column-left
    }

    Mod+Ctrl+WheelScrollRight {
        move-column-right
    }

    Mod+Ctrl+Home {
        move-column-to-first
    }

    Mod+Ctrl+End {
        move-column-to-last
    }

    // ═══ 工作区 ═══
    Mod+1 {
        focus-workspace 1
    }

    Mod+2 {
        focus-workspace 2
    }

    Mod+3 {
        focus-workspace 3
    }

    Mod+4 {
        focus-workspace 4
    }

    Mod+5 {
        focus-workspace 5
    }

    Mod+6 {
        focus-workspace 6
    }

    Mod+7 {
        focus-workspace 7
    }

    Mod+8 {
        focus-workspace 8
    }

    Mod+9 {
        focus-workspace 9
    }

    Mod+Shift+1 {
        move-column-to-workspace 1
    }

    Mod+Shift+2 {
        move-column-to-workspace 2
    }

    Mod+Shift+3 {
        move-column-to-workspace 3
    }

    Mod+Shift+4 {
        move-column-to-workspace 4
    }

    Mod+Shift+5 {
        move-column-to-workspace 5
    }

    Mod+Shift+6 {
        move-column-to-workspace 6
    }

    Mod+Shift+7 {
        move-column-to-workspace 7
    }

    Mod+Shift+8 {
        move-column-to-workspace 8
    }

    Mod+Shift+9 {
        move-column-to-workspace 9
    }

    Mod+I {
        focus-workspace-up
    }

    Mod+U {
        focus-workspace-down
    }

    Mod+Page_Up {
        focus-workspace-up
    }

    Mod+Page_Down {
        focus-workspace-down
    }

    Mod+Ctrl+I {
        move-column-to-workspace-up
    }

    Mod+Ctrl+U {
        move-column-to-workspace-down
    }

    Mod+Ctrl+Up {
        move-column-to-workspace-up
    }

    Mod+Ctrl+Down {
        move-column-to-workspace-down
    }

    Mod+Shift+I {
        move-workspace-up
    }

    Mod+Shift+U {
        move-workspace-down
    }

    Mod+Shift+Page_Up {
        move-workspace-up
    }

    Mod+Shift+Page_Down {
        move-workspace-down
    }

    Mod+WheelScrollUp cooldown-ms=150 {
        focus-workspace-up
    }

    Mod+WheelScrollDown cooldown-ms=150 {
        focus-workspace-down
    }

    Mod+Ctrl+WheelScrollUp cooldown-ms=150 {
        move-column-to-workspace-up
    }

    Mod+Ctrl+WheelScrollDown cooldown-ms=150 {
        move-column-to-workspace-down
    }

    // ═══ 显示器 ═══
    Mod+Ctrl+H {
        focus-monitor-left
    }

    Mod+Ctrl+J {
        focus-monitor-down
    }

    Mod+Ctrl+K {
        focus-monitor-up
    }

    Mod+Ctrl+L {
        focus-monitor-right
    }

    Mod+Ctrl+Left {
        focus-monitor-left
    }

    Mod+Ctrl+Right {
        focus-monitor-right
    }

    Mod+Shift+Ctrl+H {
        move-column-to-monitor-left
    }

    Mod+Shift+Ctrl+J {
        move-column-to-monitor-down
    }

    Mod+Shift+Ctrl+K {
        move-column-to-monitor-up
    }

    Mod+Shift+Ctrl+L {
        move-column-to-monitor-right
    }

    Mod+Shift+Ctrl+Left {
        move-column-to-monitor-left
    }

    Mod+Shift+Ctrl+Right {
        move-column-to-monitor-right
    }

    Mod+Shift+Ctrl+Up {
        move-column-to-monitor-up
    }

    Mod+Shift+Ctrl+Down {
        move-column-to-monitor-down
    }

    // ═══ 概览/其他 ═══
    Mod+D repeat=false {
        toggle-overview
    }

    Mod+Tab repeat=false {
        toggle-overview
    }

    Mod+Shift+Slash {
        show-hotkey-overlay
    }

    Mod+Escape allow-inhibiting=false {
        toggle-keyboard-shortcuts-inhibit
    }

    Mod+Shift+P {
        power-off-monitors
    }

    // ═══ 截屏 ═══
    // Print 系走 niri 内置；noctalia 的截屏（region/fullscreen/annotate）在控制中心
    Print {
        screenshot
    }

    Ctrl+Print {
        screenshot-screen
    }

    Alt+Print {
        screenshot-window
    }

    Super+Shift+S {
        screenshot
    }

    XF86Launch1 {
        screenshot
    }

    Alt+XF86Launch1 {
        screenshot-window
    }

    Ctrl+XF86Launch1 {
        screenshot-screen
    }

    // ═══ noctalia 面板（启动器/控制中心/剪贴板/壁纸/会话/设置）═══
    Mod+Space hotkey-overlay-title="Launcher" {
        spawn "noctalia" "msg" "panel-toggle" "launcher"
    }

    Mod+S hotkey-overlay-title="Control Center" {
        spawn "noctalia" "msg" "panel-toggle" "control-center"
    }

    Mod+Comma hotkey-overlay-title="Noctalia Settings" {
        spawn "noctalia" "msg" "settings-toggle"
    }

    Mod+V hotkey-overlay-title="Clipboard History" {
        spawn "noctalia" "msg" "panel-toggle" "clipboard"
    }

    Mod+Shift+W hotkey-overlay-title="Wallpaper Picker" {
        spawn "noctalia" "msg" "panel-toggle" "wallpaper"
    }

    Mod+X hotkey-overlay-title="Session (Power Menu)" {
        spawn "noctalia" "msg" "panel-toggle" "session"
    }

    Mod+Alt+L hotkey-overlay-title="Lock Screen" {
        spawn "noctalia" "msg" "session" "lock"
    }

    // ═══ 音量/亮度/媒体（noctalia 出 OSD；音量键是 repeating，msg 天然支持）═══
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "noctalia" "msg" "volume-up"
    }

    XF86AudioLowerVolume allow-when-locked=true {
        spawn "noctalia" "msg" "volume-down"
    }

    XF86AudioMute allow-when-locked=true {
        spawn "noctalia" "msg" "volume-mute"
    }

    XF86AudioMicMute allow-when-locked=true {
        spawn "noctalia" "msg" "mic-mute"
    }

    XF86AudioPlay allow-when-locked=true {
        spawn "noctalia" "msg" "media" "toggle"
    }

    XF86AudioPause allow-when-locked=true {
        spawn "noctalia" "msg" "media" "toggle"
    }

    XF86AudioNext allow-when-locked=true {
        spawn "noctalia" "msg" "media" "next"
    }

    XF86AudioPrev allow-when-locked=true {
        spawn "noctalia" "msg" "media" "previous"
    }

    XF86MonBrightnessUp allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-up"
    }

    XF86MonBrightnessDown allow-when-locked=true {
        spawn "noctalia" "msg" "brightness-down"
    }
}
