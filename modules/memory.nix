# /etc/nixos/configuration.nix
{ pkgs, ... }:

{
  # =========================================================================
  # 1. 开启 ZRAM 内存压缩（核心加速手段）
  # =========================================================================
  zramSwap = {
    enable = true;
    algorithm = "zstd";    # 压缩算法：zstd 平衡最好，lz4 速度最快。现代 CPU 闭眼选 zstd 即可
    memoryPercent = 50;    # 允许 ZRAM 盘最多占用物理内存的百分比（默认 50% 非常合理）
    priority = 100;        # 关键：优先级设为 100，确保 Linux 优先把数据往 ZRAM 里塞
  };
}
